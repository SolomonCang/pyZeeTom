{
  "_comment": "pyZeeTom configuration file. Use this file instead of params_tomog.txt for clearer, named parameter input. Pass this file to forward_tomography() or inversion_tomography() as param_file='input/config.json'.",

  "star": {
    "_comment": "Stellar and disk rotation parameters",
    "inclination": 60.0,
    "vsini": 40.0,
    "period": 1.0,
    "pOmega": -0.05,
    "mass": 1.0,
    "radius": 0.8
  },

  "grid": {
    "_comment": "Disk grid parameters. Set Vmax>0 to override automatic derivation from r_out.",
    "nRings": 10,
    "Vmax": 0.0,
    "r_out": 3.0,
    "enable_occultation": 0
  },

  "inversion": {
    "_comment": "MEM inversion control. targetForm: 'C' targets chi^2, 'E' targets entropy.",
    "targetForm": "C",
    "targetValue": 1.5,
    "numIterations": 5,
    "test_aim": 1e-3
  },

  "line_model": {
    "_comment": "Spectral line model parameters.",
    "lineAmpConst": 1.0,
    "k_QU": 1.0,
    "enableV": 0,
    "enableQU": 0
  },

  "initial_model": {
    "_comment": "Load an initial model from a .tomog file. Set initTomogFile=1 to enable.",
    "initTomogFile": 1,
    "initModelPath": "output/spot_truth.tomog"
  },

  "fit_flags": {
    "_comment": "Switches for which parameters are optimised during inversion (1=on, 0=off).",
    "fitBri": 1,
    "fitMag": 1,
    "fitBlos": 1,
    "fitBperp": 1,
    "fitChi": 0
  },

  "spectral": {
    "_comment": "Spectral / instrument settings.",
    "spectralResolution": 65000,
    "lineParamFile": "input/lines.txt",
    "velStart": -400.0,
    "velEnd": 400.0,
    "obsFileType": "lsd_pol",
    "polOut": "V",
    "specType": "auto"
  },

